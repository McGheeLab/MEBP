#!/usr/bin/env python3
import threading
import time
import argparse

import numpy as np
import pandas as pd

from DeviceInterface import XYStageManager, ZPStageManager 

class StageController:
    def __init__(self, csv_path, simulate=False):
        # load raw trajectory
        self.df = pd.read_csv(csv_path)
        self.simulate = simulate

        # instantiate both managers
        self.xy_mgr = XYStageManager(simulate=simulate)
        self.z_mgr = ZPStageManager(simulate=simulate)

        # placeholders for the interpolated trajectories
        self.xy_times = None
        self.xy_x = None
        self.xy_y = None
        self.z_times = None
        self.z_z = None

    def makespiral(self):
                # Trajectory parameters
        duration    = 120.0       # total time [s]
        dt          = 0.1         # time step [s]
        turns       = 3           # number of spiral revolutions
        max_radius  = 10.0        # final spiral radius [mm]
        z_diameter  = 3.0         # circle diameter in Z [mm]
        z_amp       = z_diameter / 2.0

        # build time vector
        times = np.arange(0.0, duration + dt/2, dt)

        # spiral in XY: r grows linearly, theta runs through 'turns' revolutions
        r     = max_radius * (times / duration)
        theta = 2 * np.pi * turns * (times / duration)
        x     = r * np.cos(theta)
        y     = r * np.sin(theta)

        # circle in Z: simple sinusoid for a full period over 'duration'
        z     = z_amp * np.sin(2 * np.pi * times / duration)

        # assemble and save
        df = pd.DataFrame({
            'time': times,
            'x':    x,
            'y':    y,
            'z':    z
        })
        df.to_csv('spiral_circle_trajectory.csv', index=False)
        print("Wrote spiral_circle_trajectory.csv with", len(df), "points.")
    
    def interpolate_trajectories(self, dt_xy=1.0, dt_z=0.33):
        t0 = self.df['time'].iloc[0]
        t1 = self.df['time'].iloc[-1]

        # build uniform time axes
        self.xy_times = np.arange(t0, t1 + dt_xy, dt_xy)
        self.z_times  = np.arange(t0, t1 + dt_z,  dt_z)

        # interpolate
        self.xy_x = np.interp(self.xy_times, self.df['time'], self.df['x'])
        self.xy_y = np.interp(self.xy_times, self.df['time'], self.df['y'])
        self.z_z  = np.interp(self.z_times,  self.df['time'], self.df['z'])

    def run(self):
        # record wall-clock time at t = self.xy_times[0]
        start_wall = time.time()
        t0 = self.xy_times[0]

        # XY update thread
        def xy_loop():
            for i in range(len(self.xy_times) - 1):
                t_curr = self.xy_times[i]
                t_next = self.xy_times[i+1]
                dt = t_next - t_curr

                # velocity in mm/s
                vx = (self.xy_x[i+1] - self.xy_x[i]) / dt
                vy = (self.xy_y[i+1] - self.xy_y[i]) / dt

                # send velocity command
                self.xy_mgr.move_stage_at_velocity(vx, vy)

                # sleep until it's time for next update
                target = start_wall + (t_next - t0)
                sleep = target - time.time()
                if sleep > 0:
                    time.sleep(sleep)

            # stop movement at end
            self.xy_mgr.move_stage_at_velocity(0, 0)

        # Z update thread
        def z_loop():
            for i in range(len(self.z_times) - 1):
                t_curr = self.z_times[i]
                t_next = self.z_times[i+1]
                dt = t_next - t_curr
                dz = self.z_z[i+1] - self.z_z[i]

                # feedrate in mm/min required to cover dz in dt seconds
                feed_mm_per_min = abs(dz) / dt * 60.0

                # move relative in Z
                self.z_mgr.move_relative({'Z': dz}, feedrate=feed_mm_per_min)

                # sleep until next
                target = start_wall + (t_curr + dt - t0)
                sleep = target - time.time()
                if sleep > 0:
                    time.sleep(sleep)

        # start both loops
        t_xy = threading.Thread(target=xy_loop, name="XY-Loop")
        t_z  = threading.Thread(target=z_loop,  name="Z-Loop")
        t_xy.start()
        t_z.start()
        t_xy.join()
        t_z.join()

if __name__ == "__main__":
    
    controller = StageController("spiral_circle_trajectory.csv", simulate=False)
    controller.interpolate_trajectories(dt_xy=1.0, dt_z=0.33)
    controller.run()
