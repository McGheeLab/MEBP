# PyInstaller build artifacts
build/
dist/
*.spec
!MEBP.spec

# Python
__pycache__/
*.py[cod]
*.pyo
*.egg-info/

# macOS
.DS_Store

# Runtime / user data
settings.json
settings.json.bak-*
print_resume.json
current_button_mapping.json
print_records/
config/sim_xy_state.json
config/sim_xy_state_ludl.json
config/sim_zp_state.json
xy_debug_*.csv

# ---------------------------------------------------------------------------
# Per-machine state — NEVER share between rigs.
#
# These files describe THIS physical machine: what its cameras measured, where
# its plate is, how its stage is wired. Carrying one rig's values onto another
# is the failure this codebase has been bitten by repeatedly (see the
# CAMERA_CAL_PERSIST_STORE and PLATE_ORIENTATION notes in CLAUDE.md) — a stale
# calibration silently drives the needle to the wrong place.
#
# Swappable print setups (config/hardware/*Setup*.json) and the shared
# catalogues (needles, syringes, cameras, plate/needle/well/target types,
# plates, inserts) stay tracked: those are meant to travel between machines.
# ---------------------------------------------------------------------------
config/hardware/devices/
config/hardware/calibration_status.json
config/hardware/camera_calibrations.json
config/hardware/fluorescence_mosaics.json
# v7.18 incubator config — which zone has a heater is wiring on THIS rig
# (on ME3B V1 only the bed output HB has one; Zone B/HE0 is disabled here).
config/hardware/incubator.json
config/hardware/incubator_calibration.json
config/hardware/last_calibration.json
config/hardware/microscope.json
# LabLink node config — per-machine AND it holds a bearer site token. The
# older vendored lablink_connect.py shipped a live token to GitHub because
# this line was not written at the same time as the code that needed it.
config/hardware/lablink.json
config/hardware/lablink_results.json
config/hardware/lablink_results/
config/hardware/lablink_outbox/
config/hardware/mosaic_alignment.json
config/hardware/objectives.json
config/hardware/plate_mosaics.json
config/hardware/print_timing_calibration.json
config/hardware/reanchor_features.json

# Scanned mosaic images — regenerated by scanning a plate, so they are output,
# not source. Several hundred MB if tracked; the real-mosaic tests self-skip
# when they are absent.
config/hardware/mosaics/
config/hardware/fluor_mosaics/

# Application logs, including the rotated copies. Tracking these put ~500k
# lines of churn into a single commit.
logs/*.log
logs/*.log.[0-9]
logs/*.log.[0-9][0-9]

# Print execution logs (keep the schema README, ignore the runs)
logs/prints/*.jsonl

# Incubator telemetry runs + the simulator's scratch EEPROM (v7.18)
logs/incubator/*.jsonl
logs/incubator/sim_incubator_state.json

# Deliberately KEPT: logs/hwtest, logs/challenge and logs/timing hold
# hardware-run records that the update plans cite as evidence.

# IDE
.vscode/
.idea/

# Testing
.pytest_cache/

# Walkthrough recordings (REC button): one full-window PNG per click,
# so a single take is tens of MB of binaries.
logs/sessions/

# HyperFrames tutorial videos — commit the composition + generated CSS,
# ignore the toolchain, rendered MP4s and review snapshots.
docs/videos/*/node_modules/
docs/videos/*/out/
docs/videos/*/snapshots/
docs/videos/*/.hyperframes/

# Tucsen TUCam SDK per-camera parameter files. The SDK writes one XML per
# physical unit (named with its serial) into the config path we hand it; that is
# machine-local state for one specific camera, not something another rig wants.
config/hardware/tucsen/

# v7.14 operator captures (📷 / ⏺ buttons on every live feed): full-resolution
# 16-bit TIFFs and video are large experiment data, not source. This is only
# the DEFAULT destination — the capture settings dialog can point anywhere.
captures/

# v7.16 .nd3 exports written by the end-to-end checks in logs/nd3/. The rest of
# logs/ is covered by `logs/*.log` above, which does not match these — a 16 MB
# HDF5 container of one plate's imagery is experiment output, not source.
logs/nd3/

# Scratch directory a test run moved stray plate documents into. Debris, not a
# fixture: the plate-document tests build what they need in a tmpdir.
.trash-testdebris/
