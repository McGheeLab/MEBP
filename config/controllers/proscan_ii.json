{
    "controller_name": "Prior ProScan II",
    "manufacturer": "Prior Scientific",
    "protocol_version": "II",
    "communication": {
        "line_terminator_tx": "\\r",
        "line_terminator_rx": "\\r",
        "default_baud_rate": 38400,
        "byte_size": 8,
        "stop_bits": 1,
        "timeout_s": 0.1,
        "encoding": "ascii"
    },
    "detection": {
        "wake_command": null,
        "wake_delay_ms": 0,
        "firmware_query": "P",
        "identify_tokens": [
            "0",
            "1"
        ],
        "response_pattern": "^-?\\d+,-?\\d+",
        "notes": "v7.2.8-fix: Use P (position query) for detection. V returns E,4 on ProScan II. COMP returns 0/1 which doesn't match the response_pattern. P always works and returns comma-separated numbers that match the pattern."
    },
    "response_semantics": {
        "ack_success_token": "R",
        "ack_error_pattern": "^E,\\s*(-?\\d+)"
    },
    "commands": {
        "position_query": {
            "cmd": "P",
            "response": "{x},{y},{z}"
        },
        "move_absolute": {
            "cmd": "G,{x},{y}",
            "response": "R"
        },
        "move_relative": {
            "cmd": "GR,{dx},{dy}",
            "response": "R"
        },
        "set_velocity": {
            "cmd": "VS,{vx},{vy}",
            "response": "R"
        },
        "set_max_speed": {
            "cmd": "SMS,{speed}",
            "response": "R"
        },
        "get_max_speed": {
            "cmd": "SMS",
            "response": "{value}"
        },
        "set_acceleration": {
            "cmd": "SAS,{accel}",
            "response": "R"
        },
        "get_acceleration": {
            "cmd": "SAS",
            "response": "{value}"
        },
        "set_jerk": null,
        "set_home": {
            "cmd": "Z",
            "response": "R"
        },
        "stop": {
            "cmd": "I",
            "response": "R"
        },
        "firmware_version": {
            "cmd": "V",
            "response": "{version}"
        },
        "stage_type": null
    },
    "parameters": {
        "speed_range": [
            1,
            100
        ],
        "acceleration_range": [
            1,
            100
        ],
        "jerk_range": null,
        "position_units": "microns",
        "xy_position_scale": 1.0,
        "position_range_x": [
            -100000,
            100000
        ],
        "position_range_y": [
            -100000,
            100000
        ]
    }
}